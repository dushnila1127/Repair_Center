<Window x:Class="RepairCenter.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RepairCenter — новый сотрудник" Height="720" Width="560" MinHeight="600" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F3F5F9"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="108"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17243A">
            <StackPanel Margin="30,20,25,18" VerticalAlignment="Center">
                <TextBlock Text="Создание учётной записи" FontSize="23" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="RepairCenter" Foreground="#AAB8CE" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="24,18,24,24" Padding="23" VerticalAlignment="Stretch">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button Content="Создать сотрудника" Height="42" Background="#17865C" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Click="Register_Click" IsDefault="True"/>
                    <Button Content="Отмена" Height="38" Margin="0,9,0,0" Background="#E9EDF4" Foreground="#25344B" FontSize="13" BorderThickness="0" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Данные сотрудника" FontSize="19" FontWeight="Bold" Foreground="#182338" Margin="0,0,0,14"/>
                        <TextBlock Text="ФИО" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <TextBox x:Name="FullNameText" Height="36" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>
                        <TextBlock Text="Телефон" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <TextBox x:Name="PhoneText" Height="36" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>
                        <TextBlock Text="Логин" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <TextBox x:Name="LoginText" Height="36" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>
                        <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordInput" Height="36" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>
                        <TextBlock Text="Повторите пароль" FontSize="12" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPasswordInput" Height="36" FontSize="13" Padding="8,5" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
