<Window x:Class="RepairCenter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repair center" Height="570" Width="520" MinHeight="500" MinWidth="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#F3F5F9"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17243A">
            <StackPanel Margin="34,24,30,20" VerticalAlignment="Center">
                <TextBlock Text="Repair center" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Сервисный центр" Foreground="#AAB8CE" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="24,18,24,24" Padding="25" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" Foreground="#182338" Margin="0,0,0,20"/>
                    <TextBlock Text="Логин" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginText" Height="40" FontSize="14" Padding="10,7" Margin="0,0,0,14"/>
                    <TextBlock Text="Пароль" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordInput" Height="40" FontSize="14" Padding="10,7" Margin="0,0,0,20"/>
                    <Button Content="Войти" Height="42" Background="#2864D7" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Click="Login_Click" IsDefault="True"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
