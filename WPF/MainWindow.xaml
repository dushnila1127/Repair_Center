<Window x:Class="RepairCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Repair center" Height="800" Width="1360" MinHeight="680" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#17243A"><DockPanel LastChildFill="True">
<StackPanel DockPanel.Dock="Top" Margin="20,26,16,24"><TextBlock Text="Repair center" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="SessionLabel" Text="" Foreground="#AAB8CE" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,20"><Button x:Name="LogoutNav" Content="Выйти" Height="42" Margin="0,4,0,0" Background="#314766" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Logout_Click"/></StackPanel>
<StackPanel Margin="10,0">
<Button x:Name="OrdersNav" Content="Заказы" Height="44" Margin="0,3" Background="#314766" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Orders_Click"/>
<Button x:Name="ClientsNav" Content="Клиенты" Height="44" Margin="0,3" Background="Transparent" Foreground="#D6DFED" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Clients_Click"/>
<Button x:Name="EquipmentNav" Content="Техника" Height="44" Margin="0,3" Background="Transparent" Foreground="#D6DFED" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Equipment_Click"/>
<Button x:Name="EmployeesNav" Content="Исполнители" Height="44" Margin="0,3" Background="Transparent" Foreground="#D6DFED" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Employees_Click"/>
<Button x:Name="ReportsNav" Content="Отчёты" Height="44" Margin="0,3" Background="Transparent" Foreground="#D6DFED" BorderThickness="0" HorizontalContentAlignment="Left" Padding="16,0" FontSize="14" Click="Reports_Click"/>
</StackPanel>
</DockPanel></Border>
<ContentControl x:Name="PageHost" Grid.Column="1" Margin="28"/>
</Grid></Window>
